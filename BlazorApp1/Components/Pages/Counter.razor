@page "/produtos"
@rendermode InteractiveServer

<PageTitle>Produtos - Mini Loja</PageTitle>

<div class="pagina">

    <div class="titulo-pagina">
        <h1>Nossos Produtos </h1>
        <p>Escolha seus produtos favoritos.</p>
    </div>

    <div class="produtos">

        <div class="produto">
            <div class="produto-imagem">🎧</div>

            <div class="produto-info">
                <h2>Fone Bluetooth</h2>

                <p>
                    Fone sem fio com ótima qualidade de som.
                </p>

                <span class="preco">R$ 89,90</span>

                <button @onclick="AdicionarFone">
                    🛒 Adicionar ao carrinho
                </button>
            </div>
        </div>


        <div class="produto">
            <div class="produto-imagem">⌚</div>

            <div class="produto-info">
                <h2>Smartwatch</h2>

                <p>
                    Relógio inteligente moderno e confortável.
                </p>

                <span class="preco">R$ 149,90</span>

                <button @onclick="AdicionarSmartwatch">
                    🛒 Adicionar ao carrinho
                </button>
            </div>
        </div>


        <div class="produto">
            <div class="produto-imagem">⌨️</div>

            <div class="produto-info">
                <h2>Teclado Gamer</h2>

                <p>
                    Teclado mecânico para jogos e trabalho.
                </p>

                <span class="preco">R$ 199,90</span>

                <button @onclick="AdicionarTeclado">
                    🛒 Adicionar ao carrinho
                </button>
            </div>
        </div>


        <div class="produto">
            <div class="produto-imagem">🖱️</div>

            <div class="produto-info">
                <h2>Mouse Gamer</h2>

                <p>
                    Mouse preciso e confortável para jogar.
                </p>

                <span class="preco">R$ 79,90</span>

                <button @onclick="AdicionarMouse">
                    🛒 Adicionar ao carrinho
                </button>
            </div>
        </div>


        <div class="produto">
            <div class="produto-imagem">🔊</div>

            <div class="produto-info">
                <h2>Caixa de Som</h2>

                <p>
                    Caixa de som portátil com conexão Bluetooth.
                </p>

                <span class="preco">R$ 129,90</span>

                <button @onclick="AdicionarCaixa">
                    🛒 Adicionar ao carrinho
                </button>
            </div>
        </div>


        <div class="produto">
            <div class="produto-imagem">🎮</div>

            <div class="produto-info">
                <h2>Headset Gamer</h2>

                <p>
                    Headset com microfone para jogos.
                </p>

                <span class="preco">R$ 159,90</span>

                <button @onclick="AdicionarHeadset">
                    🛒 Adicionar ao carrinho
                </button>
            </div>
        </div>

    </div>

    @if (!string.IsNullOrEmpty(mensagem))
    {
        <div class="mensagem">
            @mensagem
        </div>
    }

</div>

@code {

    private string mensagem = "";

    private void AdicionarFone()
    {
        mensagem = "Fone Bluetooth adicionado ao carrinho!";
    }

    private void AdicionarSmartwatch()
    {
        mensagem = "Smartwatch adicionado ao carrinho!";
    }

    private void AdicionarTeclado()
    {
        mensagem = "Teclado Gamer adicionado ao carrinho!";
    }

    private void AdicionarMouse()
    {
        mensagem = "Mouse Gamer adicionado ao carrinho!";
    }

    private void AdicionarCaixa()
    {
        mensagem = "Caixa de Som adicionada ao carrinho!";
    }

    private void AdicionarHeadset()
    {
        mensagem = "Headset Gamer adicionado ao carrinho!";
    }
}