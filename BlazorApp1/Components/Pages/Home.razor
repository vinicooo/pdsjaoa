@page "/"

<PageTitle>Mini Loja</PageTitle>

<div class="inicio">
    <section class="banner">
        <div class="banner-conteudo">
            <h1>Bem-vindo à Mini Loja 🛍️</h1>

            <p>
                Encontre produtos de qualidade por preços especiais.
            </p>

            <a href="/produtos" class="botao">
                Ver produtos
            </a>
        </div>
    </section>

    <section class="vantagens">
        <h2>Por que comprar conosco?</h2>

        <div class="cards-vantagens">

            <div class="card-vantagem">
                <div class="icone">🚚</div>
                <h3>Entrega rápida</h3>
                <p>Receba seus produtos com rapidez e segurança.</p>
            </div>

            <div class="card-vantagem">
                <div class="icone"></div>
                <h3>Pagamento seguro</h3>
                <p>Tenha segurança durante todo o processo de compra.</p>
            </div>

            <div class="card-vantagem">
                <div class="icone">⭐</div>
                <h3>Qualidade</h3>
                <p>Produtos selecionados pensando em nossos clientes.</p>
            </div>

        </div>
    </section>
</div>